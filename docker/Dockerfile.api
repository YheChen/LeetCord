FROM node:20-alpine AS base

WORKDIR /app

# Prisma's query engine links against OpenSSL and its version detection is unreliable
# on Alpine without this package, producing a confusing "Unable to require libquery_engine"
# at runtime rather than a clear error at build time.
RUN apk add --no-cache openssl

COPY package.json pnpm-workspace.yaml tsconfig.base.json .eslintrc.cjs .prettierrc ./
COPY packages ./packages
COPY apps ./apps

# Pin pnpm rather than using `corepack enable pnpm`, which resolves to whatever pnpm
# is latest at build time. That silently broke this image the day pnpm 11 shipped:
# pnpm 11 requires Node >= 22.13 and imports node:sqlite, which does not exist on
# Node 20, so the install died with ERR_UNKNOWN_BUILTIN_MODULE.
#
# Installed via npm rather than corepack because the corepack bundled with Node 20 is
# old enough to hit signature-verification failures fetching recent pnpm releases.
#
# Keep this in step with "packageManager" in the root package.json.
RUN npm install -g pnpm@10.31.0 && pnpm install --recursive --silent

# Generate the Prisma client explicitly rather than relying on the @prisma/client
# postinstall hook. The query engine is a native, architecture-specific binary, so it
# must be produced on the machine that runs the image — this is what makes moving
# from the arm64 Pi to an x86_64 host safe.
RUN pnpm --filter @leetcord/database prisma:generate

# The trailing "..." builds workspace dependencies first. @leetcord/api resolves
# @leetcord/core through its dist/ output, so without it the build fails on a
# clean checkout where no package has been compiled yet.
RUN pnpm --filter "@leetcord/api..." build

CMD ["pnpm", "--filter", "@leetcord/api", "start"]
