FROM node:20-alpine AS base

WORKDIR /app

# See Dockerfile.api — Prisma's engine needs OpenSSL present on Alpine.
RUN apk add --no-cache openssl

COPY package.json pnpm-workspace.yaml tsconfig.base.json .eslintrc.cjs .prettierrc ./
COPY packages ./packages
COPY apps ./apps

# See Dockerfile.api — pnpm is pinned because an unpinned corepack install resolves to
# pnpm 11, which requires Node >= 22.13. Keep in step with the root package.json.
RUN npm install -g pnpm@10.31.0 && pnpm install --recursive --silent

# See Dockerfile.api — the Prisma query engine is architecture-specific and must be
# generated here rather than copied from the arm64 Raspberry Pi.
RUN pnpm --filter @leetcord/database prisma:generate

# "..." also builds workspace dependencies; @leetcord/bot needs @leetcord/core's dist/.
RUN pnpm --filter "@leetcord/bot..." build

CMD ["pnpm", "--filter", "@leetcord/bot", "start"]
