DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-client-id
# Optional: one fast-registration guild for development
DISCORD_GUILD_ID=your-dev-guild-id
# Optional: comma-separated fast-registration guilds for multi-server development
# Example: DISCORD_GUILD_IDS=123456789012345678,987654321098765432
DISCORD_GUILD_IDS=

# SQLite database file.
#
# Under docker compose this value is overridden to file:/data/leetcord.db by
# docker-compose.yml, so containers always use the bind-mounted host file.
#
# For local development outside Docker, note that Prisma resolves a RELATIVE sqlite
# path against the directory holding schema.prisma (packages/database/prisma/), not
# against your shell's working directory. An absolute path avoids that trap entirely.
DATABASE_URL=file:/absolute/path/to/LeetCord/data/leetcord.db

API_PORT=3000
BOT_PUBLIC_URL=http://localhost:3000
LEETCODE_FETCH_USER_AGENT=LeetCordBot/0.1.0
LOG_LEVEL=info

# Only needed while migrating off Supabase; the export script reads this instead of
# DATABASE_URL so it can still reach the old Postgres server after the cutover.
# Delete this line once the migration is done and the Supabase project is gone.
# POSTGRES_EXPORT_URL=postgresql://user:password@host:5432/postgres?sslmode=require
