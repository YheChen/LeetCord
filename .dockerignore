# Keep the build context small and, more importantly, keep host state out of the image.
#
# node_modules and dist are rebuilt inside the image; copying a host node_modules in
# would drag along native binaries built for the host's architecture, which is exactly
# the arm64-vs-x86_64 trap this deployment is avoiding.

node_modules
**/node_modules
dist
**/dist

# The SQLite database, its WAL sidecars and the migration dump are real user data and
# must never be baked into an image.
data
*.db
*.db-journal
*.db-shm
*.db-wal
leetcord-export.json

# Secrets reach containers through env_file at runtime, never through the image.
.env

# Generated Prisma client; regenerated inside the image for the correct architecture.
packages/database/generated

.git
.gitignore
*.log
.DS_Store
LeetCord.png
